# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-4-argon
# Token Optimization: restrict Gemini calls to active market hours (true/false)
GEMINI_RESTRICT_TO_TRADING_HOURS=true
GEMINI_STOCK_REGULAR_HOURS_ONLY=false

# OANDA Broker Configuration (Forex Bot)
OANDA_API_KEY=your_oanda_v20_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
# Environment: "practice" for demo, "live" for real money, "simulator" for offline mock
OANDA_ENVIRONMENT=simulator

# Alpaca Broker Configuration (Stock Bot)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Environment: "paper" for paper trading, "live" for real money, "simulator" for offline mock
ALPACA_ENVIRONMENT=simulator

# Forex Trading Configuration
DEFAULT_INSTRUMENT=EUR_USD
SCAN_INTERVAL_SECONDS=10
RISK_PERCENT_PER_TRADE=1.0
MAX_DAILY_DRAWDOWN_PERCENT=3.0
MAX_OPEN_POSITIONS=5
SPREAD_LIMIT_PIPS=2.5

# Stock Trading Configuration
DEFAULT_STOCK_SYMBOL=AAPL
STOCK_SCAN_INTERVAL_SECONDS=10
STOCK_RISK_PERCENT_PER_TRADE=1.0
STOCK_MAX_DAILY_DRAWDOWN_PERCENT=3.0
STOCK_MAX_OPEN_POSITIONS=20

# Crypto Trading Configuration (Alpaca 24/7 Top 20 Spot)
DEFAULT_CRYPTO_SYMBOL=BTC/USD
CRYPTO_SCAN_INTERVAL_SECONDS=15
CRYPTO_RISK_PERCENT_PER_TRADE=1.25
CRYPTO_MAX_DAILY_DRAWDOWN_PERCENT=4.0
CRYPTO_MAX_OPEN_POSITIONS=6
CRYPTO_MAX_PORTFOLIO_EXPOSURE_PCT=65.0
ALPACA_CRYPTO_LOC=us

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
# Comma-separated allowed CORS origins (never use * in production)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ENABLE_API_DOCS=false

# Security & Authentication Configuration
AUTH_ENABLED=true
AUTH_USERNAME=admin
# IMPORTANT: Change password or store PBKDF2 hash from agent.security.auth.hash_password()
AUTH_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_OR_PBKDF2_HASH
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=generate_a_random_secret_string_here
AUTH_SESSION_EXPIRE_HOURS=72
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
GOOGLE_ALLOWED_EMAIL=oubou68@gmail.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
