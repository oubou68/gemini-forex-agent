# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OANDA Broker Configuration (Forex Bot)
OANDA_API_KEY=your_oanda_v20_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
# Environment: "practice" for demo, "live" for real money, "simulator" for offline mock
OANDA_ENVIRONMENT=simulator

# Alpaca Broker Configuration (Stock Bot)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Environment: "paper" for paper trading, "live" for real money, "simulator" for offline mock
ALPACA_ENVIRONMENT=simulator

# Forex Trading Configuration
DEFAULT_INSTRUMENT=EUR_USD
SCAN_INTERVAL_SECONDS=10
RISK_PERCENT_PER_TRADE=1.0
MAX_DAILY_DRAWDOWN_PERCENT=3.0
MAX_OPEN_POSITIONS=3
SPREAD_LIMIT_PIPS=2.5

# Stock Trading Configuration
DEFAULT_STOCK_SYMBOL=AAPL
STOCK_SCAN_INTERVAL_SECONDS=10
STOCK_RISK_PERCENT_PER_TRADE=1.0
STOCK_MAX_DAILY_DRAWDOWN_PERCENT=3.0
STOCK_MAX_OPEN_POSITIONS=3

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
